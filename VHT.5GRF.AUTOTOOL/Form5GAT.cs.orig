        public void Config()
        {
            btnStart.Enabled = true;
            timerProcess.Stop();
            time = 0;
            numberMeasClause = 0;
            numberPortChecked = 0;
            prgLoad_ValueChange(1000, 0);
            count = 0;
            VSA.RRUinfo(rruSerial);

            //...............................info RRU

            Measurement.Reset();
            TimeSpan timeCount = TimeSpan.FromSeconds(time);
            lblRuntime.Text = timeCount.ToString();
            setFrequency = Convert.ToString((double.Parse(txtFrequency.Text) * 1000000));    // chuyen doi frequency tu MHz sang Hz
            setPower = txtPWR.Text;
            setBandwidth = textBandwidth.Text;
            for (int i = 0; i < 32; i++)
            {
                string chkPortIndex = "chkPort" + (i + 1);
                CheckBox checkbox = (CheckBox)this.Controls.Find(chkPortIndex, true)[0];
                setPort[i] = checkbox.Checked;
                if (checkbox.Checked)
                {
                    numberPortChecked++;
                }
            }
            frmRFSwitch.RFSwitchSetup(out rfs1Ax, out rfs2Ax, out rfs3Ax);
            Array.Clear(measClause, 0, measClause.Length);
            try
            {
                int l = 0, m = 0;
                foreach (TreeNode node in trvTestCases.Nodes)
                {
                    if (node.Checked)
                    {
                        foreach (TreeNode childnode in node.Nodes)
                        {
                            if (childnode.Checked)
                            {

                                Console.WriteLine(childnode.Text);
                                for (int i = 0; i < loadExcelClause.GetLength(0); i++)
                                {
                                    if (loadExcelClause[i, 0] != null)
                                    {
                                        for (int j = 0; j < loadExcelClause.GetLength(1); j++)
                                        {
                                            if (loadExcelClause[i, j] == childnode.Text)
                                            {
                                                measClause[l, m] = loadExcelClause[i, j];
                                                measClause[l, m + 1] = loadExcelClause[i, j + 1];
                                                measClause[l, m + 2] = loadExcelClause[i, j + 2];
                                                measClause[l, m + 3] = loadExcelClause[i, j + 3];
                                                measClause[l, m + 4] = loadExcelClause[i, j + 4];
                                                measClause[l, m + 5] = loadExcelClause[i, j + 5];
                                                measClause[l, m + 6] = loadExcelClause[i, j + 6];
                                                measClause[l, m + 7] = loadExcelClause[i, j + 7];
                                                measClause[l, m + 8] = loadExcelClause[i, j + 8];
                                                measClause[l, m + 8] = loadExcelClause[i, j + 8];
                                                measClause[l, m + 9] = loadExcelClause[i, j + 9];
                                                measClause[l, m + 10] = loadExcelClause[i, j + 10];
                                                measClause[l, m + 11] = loadExcelClause[i, j + 11];
                                                measClause[l, m + 12] = loadExcelClause[i, j + 12];
                                                measClause[l, m + 13] = loadExcelClause[i, j + 13];
                                                l++;
                                                m = 0;
                                                numberMeasClause++;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                bool haveSwap = false;
                for (int i = 0; i < l - 1; i++)
                {
                    for (int j = 0; j < l - i - 1; j++)
                    {
                        if (Convert.ToInt32(measClause[j, 19]) > Convert.ToInt32(measClause[j + 1, 19]))
                        {
                            Swap(measClause, j);
                            haveSwap = true;
                        }
                    }
                    if (haveSwap == false)
                    {
                        break;
                    }
                }
            }
            catch
            {
                Console.WriteLine("Load Clause : Fail");
            }
        }
