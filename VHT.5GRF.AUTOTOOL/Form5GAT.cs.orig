        public void ExportListViewReport()
        {
            try
            {
                string resultFile = "", filename;
                string directoryPath = @"C:\test3gpp\OQC\32T32R10W\results";
                //directoryPath = directoryPath + DateTime.Now.ToString("ddMMyyyy");
                filename = rruSerial.Trim() + "_PERFORMANCE-TEST_" + DateTime.Now.ToString("HHmm") + "_" + DateTime.Now.ToString("ddMMyyyy");
                DirectoryInfo directory = new DirectoryInfo(directoryPath);
                directory.Create();
                resultFile = System.IO.Path.Combine(directoryPath, filename);
                resultFile = resultFile + ".xlsx";
                if (!File.Exists(resultFile))
                {
                    System.IO.File.Copy(@"C:\test3gpp\OQC\32T32R10W\Templates\MRU32T32R_Report_Template_v1.0.xlsx", resultFile);
                }
                Cursor.Current = Cursors.WaitCursor;
                Excel.Application xlApp = new Excel.Application();
                xlApp.Visible = false;
                xlApp.DisplayAlerts = false;
                xlApp.UserControl = false;
                Excel.Workbook xlWorkbook = xlApp.Workbooks.Add(Type.Missing);
                Excel._Worksheet workSheet6 = xlWorkbook.Sheets[6];
                workSheet6 = (Excel._Worksheet)xlWorkbook.ActiveSheet;
                Excel.Range xlRange = workSheet6.UsedRange;
                workSheet6.Name = "TXRESULT";

                int i = 1;
                int j = 2;
                foreach (ColumnHeader ch in lvwResult.Columns)
                {
                    workSheet6.Cells[1, i] = ch.Text;
                    i++;
                }
                lvwResult.Invoke(new MethodInvoker(delegate ()
                {
                    foreach (ListViewItem lvi in lvwResult.Items)
                    {
                        i = 1;
                        foreach (ListViewItem.ListViewSubItem lvs in lvi.SubItems)
                        {
                            workSheet6.Cells[j, i] = lvs.Text;
                            i++;
                        }
                        j++;
                    }
                }));
                workSheet6.Cells.Select();
                workSheet6.Cells.EntireColumn.AutoFit();
                xlWorkbook.SaveAs(resultFile);
                xlApp.Quit();
                Console.WriteLine(resultFile);
                //cleanup
                GC.Collect();
                GC.WaitForPendingFinalizers();
                Marshal.ReleaseComObject(xlRange);
                Marshal.ReleaseComObject(workSheet6);
                Marshal.ReleaseComObject(xlWorkbook);
                Marshal.ReleaseComObject(xlApp);
            }
            catch
            {
                LogText("Export file fail");
            }
        }
