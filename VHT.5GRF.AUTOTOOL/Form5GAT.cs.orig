                                    //        }
                                    //    }
                                    //}
                                    dbRS[1] = RS;
                                    if ((dbRS[0] > limitMin) && (dbRS[1] > limitMax))
                                    {
                                        PassFail = fail;
                                        RS = Math.Max(dbRS[0], dbRS[1]);
                                        reTest = true;
                                    }
                                    else if (dbRS[0] > limitMin)
                                    {
                                        PassFail = fail;
                                        RS = dbRS[0];
                                        reTest = true;
                                    }
                                    else if (dbRS[1] > limitMax)
                                    {
                                        PassFail = fail;
                                        RS = dbRS[1];
                                        reTest = true;
                                    }
                                    else
                                    {
                                        PassFail = pass;
                                        RS = Math.Max(dbRS[0], dbRS[1]);
                                    }
                                    result = Math.Round(RS, 1).ToString();
                                    Console.WriteLine("Ket qua cuôi cùng  " + result);
