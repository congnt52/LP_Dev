        //
        //Swap function
        //
        public void Swap(string[,] x, int i)
        {
            string[,] temp = new string[1, 9];
            for (int j = 0; j < 9; j++)
            {
                temp[0, j] = x[i, j];
                x[i, j] = x[i + 1, j];
                x[i + 1, j] = temp[0, j];

            }
        }
