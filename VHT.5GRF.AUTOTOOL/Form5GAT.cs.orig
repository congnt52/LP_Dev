        public void VSGSendCmd(string vsg, string Cmd, out string respond)
        {
            if (vsg == "VSG1")
            {
                VSG1.SendCmd(Cmd, out respond);
            }
            else if (vsg == "VSG2")
            {
                VSG2.SendCmd(Cmd, out respond);
            }
            else if (vsg == "VSG3")
            {
                VSG3.SendCmd(Cmd, out respond);
            }
            else
            {
                respond = error;
            }
        }
