        //++++++++++++++++++ BACKGROUND WORKER +++++++++++++++++++++++++++++++++++++

        //measurementBackgroundWorker_DoWork
        //
        public void measurementBackgroundWorker_DoWork(object sender, DoWorkEventArgs e)
        {
            // in put
