                                    imdTSE[2, 1] = dbRS[1];
                                    imdTSE[2, 2] = dbRS[2];
                                    //imdTSE[2, 3] = dbRS[3];
                                    //imdTSE[2, 4] = dbRS[4];
                                    //imdTSE[2, 5] = dbRS[5];
                                    if (measurementBackgroundWorker.CancellationPending) return;
                                    System.Threading.Thread.Sleep(1);

                                    Measurement.IMDTSE5G(VSA, VSG1, BBU, mode, attIMD1, setFrequency, setPower, setBandwidth, "15", measClause[i, 6], out dbRS);
                                    imdTSE[3, 0] = dbRS[0];
                                    imdTSE[3, 1] = dbRS[1];
                                    imdTSE[3, 2] = dbRS[2];
                                    //imdTSE[3, 3] = dbRS[3];
                                    //imdTSE[3, 4] = dbRS[4];
                                    //imdTSE[3, 5] = dbRS[5];
                                    if (measurementBackgroundWorker.CancellationPending) return;
                                    System.Threading.Thread.Sleep(1);

