        public void OpenFileData(string filename)
        {
            //try
            //{
            //// Open file bai do
            string content = "";
            Excel.Application xlApp = new Excel.Application();
            Excel.Workbook xlWorkbook = xlApp.Workbooks.Open(filename);
            Excel._Worksheet xlWorksheet = xlWorkbook.Sheets[1];
            Excel.Range xlRange = xlWorksheet.UsedRange;
            int rowCount = xlRange.Rows.Count;
            int colCount = xlRange.Columns.Count;
            //Load noi dung bai do tu file excel vao mang loadExcel
            Array.Clear(loadExcelClause, 0, loadExcelClause.Length);
            for (int i = 2; i <= rowCount; i++)
            {
                if (xlRange.Cells[i, 1].Value != null)
                {
                    content += xlRange.Cells[i, 1].Value.ToString() + '\n';
                }
                for (int j = 1; j <= 14; j++)
                {
                    if (xlRange.Cells[i, 1].Value != null && xlRange.Cells[i, j].Value != null)
                    {
                        string str = xlRange.Cells[i, j].Value.ToString();
                        loadExcelClause[i - 1, j - 1] = str;
                    }
                }
            }


            for (int i = 0; i < 8; i++)
            {
                if (filename.Contains("DL"))
                {
                    arrAttDL[i] = xlRange.Cells[2, 14 + i].Value.ToString();
                    arrAttDL[i + 8] = xlRange.Cells[4, 14 + i].Value.ToString();
                    arrAttDL[i + 16] = xlRange.Cells[6, 14 + i].Value.ToString();
                    arrAttDL[i + 24] = xlRange.Cells[8, 14 + i].Value.ToString();
                    LogText("ATT Port" + (i + 1) + ": " + arrAttDL[i]);
                    LogText("ATT Port" + (i + 9) + ": " + arrAttDL[i + 8]);
                    LogText("ATT Port" + (i + 17) + ": " + arrAttDL[i + 16]);
                    LogText("ATT Port" + (i + 25) + ": " + arrAttDL[i + 24]);
                    attIMD = xlRange.Cells[2, 14 + 8].Value.ToString();
                    attIMD1 = xlRange.Cells[2, 14 + 9].Value.ToString();
                    attOnOff = xlRange.Cells[2, 14 + 10].Value.ToString();
                }

                if (filename.Contains("UL"))
                {
                    arrAttUL[i] = xlRange.Cells[2, 15 + i].Value.ToString();
                    arrAttUL[i + 8] = xlRange.Cells[4, 15 + i].Value.ToString();
                    arrAttUL[i + 16] = xlRange.Cells[6, 15 + i].Value.ToString();
                    arrAttUL[i + 24] = xlRange.Cells[8, 15 + i].Value.ToString();
                    LogText("ATT Port" + (i + 1) + ": " + arrAttUL[i]);
                    LogText("ATT Port" + (i + 9) + ": " + arrAttUL[i + 8]);
                    LogText("ATT Port" + (i + 17) + ": " + arrAttUL[i + 16]);
                    LogText("ATT Port" + (i + 25) + ": " + arrAttUL[i + 24]);
                }
            }
            frmAttenuator.attSetup(arrAttDL, arrAttUL, attIMD, attIMD1);
            // Xu ly noi dung tren Treeview
            trvTestCases.Nodes.Clear();
            string file_contents = content;
            //Console.WriteLine(content);
            string[] lines = file_contents.Split(new char[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
            int node, root;
            Dictionary<int, TreeNode> parents = new Dictionary<int, TreeNode>();
            foreach (string text_line in lines)
            {
                // See how many tabs are at the start of the line.
                int level = text_line.Length - text_line.TrimStart('+').Length;
                node = level;
                root = level - 1;
                // Add the new node.
                if (level == 0)
                {
                    parents[level] = trvTestCases.Nodes.Add(text_line.Trim());
                }
                else
                {
                    parents[level] = parents[level - 1].Nodes.Add(text_line.Trim());
                }
                parents[level].EnsureVisible();
                parents[level].Checked = true;
            }
            if (trvTestCases.Nodes.Count > 0)
                trvTestCases.Nodes[0].EnsureVisible();

            System.Runtime.InteropServices.Marshal.ReleaseComObject(xlApp);
            System.Diagnostics.Process[] process = System.Diagnostics.Process.GetProcessesByName("Excel");
            foreach (System.Diagnostics.Process p in process)
            {
                if (!string.IsNullOrEmpty(p.ProcessName))
                {
                    try
                    {
                        p.Kill();
                    }
                    catch { }
                }
            }
            Console.WriteLine("Load Setup File: " + filename);
            //}
            //catch(Exception e)
            //{
            //    Console.WriteLine("Load Setup File: FAIL");
            //}
        }

