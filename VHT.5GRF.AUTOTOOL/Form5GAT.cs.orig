                                    for (int x = 0; x < 6; x++)
                                    {
                                        for (int y = 0; y < 2; y++)
                                        {
                                            if (imdTSE[x, y] > RS)
                                            {
                                                RS = imdTSE[x, y];
                                            }
                                        }
                                    }
